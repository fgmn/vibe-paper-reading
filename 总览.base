filters:
  or:
    - file.hasTag("paper")
    - file.hasTag("project")
properties:
  note.org:
    displayName: 公司 / 专题
  note.id:
    displayName: "#"
  note.short:
    displayName: 简称
  note.date:
    displayName: 日期
  note.category:
    displayName: 分类
  note.source:
    displayName: 来源
  note.status:
    displayName: 状态
  note.rating:
    displayName: 评分
  note.pdf:
    displayName: PDF
  note.venue:
    displayName: 发表
  note.semantic:
    displayName: 语义高斯
views:
  - type: table
    name: 全部论文
    filters:
      and:
        - file.hasTag("paper")
    groupBy:
      property: org
      direction: ASC
    order:
      - id
      - short
      - date
      - category
      - source
      - status
      - rating
      - pdf
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 按分类
    filters:
      and:
        - file.hasTag("paper")
    groupBy:
      property: category
      direction: ASC
    order:
      - org
      - short
      - date
      - source
      - status
      - rating
    sort:
      - property: date
        direction: ASC
  - type: table
    name: 待读
    filters:
      and:
        - file.hasTag("paper")
        - note.status != "已读"
    order:
      - org
      - id
      - short
      - category
      - status
      - pdf
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 暂无 PDF 的项目
    filters:
      and:
        - file.hasTag("project")
    groupBy:
      property: org
      direction: ASC
    order:
      - file.name
      - date
      - category
      - status
    sort:
      - property: date
        direction: ASC
  - type: table
    name: 语义3DGS与具身导航
    filters:
      and:
        - file.hasTag("paper")
        - note.org == "专题·语义3DGS与具身导航"
    groupBy:
      property: category
      direction: ASC
    order:
      - id
      - short
      - date
      - venue
      - semantic
      - status
      - rating
      - pdf
    sort:
      - property: id
        direction: ASC
